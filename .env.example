NODE_ENV=production
PORT=3000
# Local-only; replace with a secret when deploying.
MONGO_URI=mongodb://mongo:27017/gruk_local?replicaSet=rs0
REDIS_URL=redis://redis:6379
# Supply actual secrets through the deployment provider, never commit values.
JWT_SECRET=

# HTTPS public origin for generated table QR URLs (localhost HTTP allowed only in dev).
APP_URL=
# Independent, random >=32-byte secret for 90-day table QR read/payment capabilities.
# Generate and store only in Render secret settings; rotate/reissue QR when compromised.
GRUK_QR_MESA_SECRET=
