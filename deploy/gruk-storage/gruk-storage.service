[Unit]
Description=GRUK native storage standby
After=local-fs.target
RequiresMountsFor=/srv/gruk-storage/primary /srv/gruk-storage/secondary
ConditionPathIsMountPoint=/srv/gruk-storage/primary
ConditionPathIsMountPoint=/srv/gruk-storage/secondary

[Service]
Type=simple
User=gruk-storage
Group=gruk-storage
WorkingDirectory=/opt/gruk-storage
EnvironmentFile=/etc/gruk-storage/standby.env
Environment=GRUK_NATIVE_REAL_BACKUP_ENABLED=false
ExecStartPre=/usr/bin/node /opt/gruk-storage/scripts/gruk/native-storage-host-preflight.js /srv/gruk-storage/primary/vault /srv/gruk-storage/secondary/vault
ExecStart=/usr/bin/node /opt/gruk-storage/scripts/gruk/native-storage-runtime.js
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths=/srv/gruk-storage/primary/vault
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
