<!DOCTYPE html>
<html lang="es">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Administrador GRUK</title>

<link rel="stylesheet" href="style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

<img id="logoRestaurante" width="180">

<button class="btnMenuGRUK" onclick="toggleMenuGRUK()">☰</button>

<aside id="menuAdminGRUK" class="menuAdminGRUK">

<h2>GRUK</h2>

<button onclick="cargarModuloGRUK('centro-control')">
🏠 Centro de Control
</button>

<button onclick="cargarModuloGRUK('restaurante')">
🍽 Restaurante
</button>

<button onclick="window.location.href='/laboral.html?restaurantId=' + getRestaurantId()">
👥 Laboral
</button>

<button onclick="cargarModuloGRUK('finanzas')">
💰 Finanzas
</button>

<button onclick="cargarModuloGRUK('inventario')">
📦 Inventario
</button>
<button onclick="cargarModuloGRUK('recetas')">
📖 Recetas
</button>
<button onclick="cargarModuloGRUK('costos')">
💸 Costos
</button>
<button onclick="cargarModuloGRUK('deudas')">
  💳 Deudas
</button>
<button onclick="cargarModuloGRUK('mensajes')">
💬 Mensajes
</button>
<button onclick="cargarModuloGRUK('reportes')">
📊 Reportes
</button>

<button onclick="cargarModuloGRUK('configuracion')">
⚙ Configuración
</button>

</aside>

<main class="adminContenidoGRUK">

<div id="contenidoPrincipalGRUK"></div>

</main>

<script>

const adminRestaurantId = localStorage.getItem("adminRestaurantId");

if (!adminRestaurantId){

window.location.href="/login.html";

}

</script>

<script src="/socket.io/socket.io.js"></script>
<script src="finanzas.js"></script>
<script src="js/recetas.js"></script>
<script src="js/costos.js"></script>
<script src="js/deudas.js"></script>
<script src="js/mensajes.js?v=4"></script>
<script src="js/centro-control.js"></script>

<script src="js/inventario.js"></script>
<script src="js/reportes.js"></script>
<script src="js/configuracion.js"></script>
<script src="admin.js"></script>
</body>

</html>